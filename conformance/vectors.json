    },
    {
      "id": "O8",
      "origin": "a\u0000b",
      "valid": false,
      "desc": "NUL is a control character"
    },
    {
      "id": "O9",
      "origin": "ab",
      "valid": false,
      "desc": "DEL is a control character"
    },
    {
      "id": "O10",
      "origin": "日日日日日日日日日日日日日日日日日日日日日日",
      "valid": false,
      "desc": "22 characters but 66 UTF-8 bytes — bytes, not code units (cf. T15)"
    },
    {
      "id": "O11",
      "origin": "~tilde",
      "valid": true,
      "desc": "tilde is reserved for topics only; an origin is never a frame name"
    }
  ],
  "topic": [
    {
      "id": "T1",
      "topic": "org/42/orders",
      "valid": true,
      "desc": "ordinary hierarchical topic"
    },
    {
      "id": "T2",
      "topic": "a",
      "valid": true,
      "desc": "one byte is the minimum"
    },
    {
      "id": "T3",
      "topic": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "valid": true,
      "desc": "255 bytes is the maximum"
    },
    {
      "id": "T4",
      "topic": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "valid": false,
      "desc": "256 bytes exceeds the maximum"
    },
    {
      "id": "T5",
      "topic": "",
      "valid": false,
      "desc": "empty is rejected"
    },
    {
      "id": "T6",
      "topic": "~",
      "valid": false,
      "desc": "bare reserved prefix"
    },
    {
      "id": "T7",
      "topic": "~gap",
      "valid": false,
      "desc": "forging a control frame name"
    },
    {
      "id": "T8",
      "topic": "a~b",
      "valid": true,
      "desc": "tilde is reserved only in first position"
    },
    {
      "id": "T9",
      "topic": "a\nb",
      "valid": false,
      "desc": "LF would split the frame"
    },
    {
      "id": "T10",
      "topic": "a\rb",
      "valid": false,
      "desc": "CR would split the frame"
    },
    {
      "id": "T11",
      "topic": "a\u0000b",
      "valid": false,
      "desc": "NUL truncates the field in any C-based proxy on the path"
    },
    {
      "id": "T12",
      "topic": "a\u001fb",
      "valid": false,
      "desc": "other C0 control"
    },
    {
      "id": "T13",
      "topic": "ab",
      "valid": false,
      "desc": "DEL is excluded alongside the C0 controls"
    },
    {
      "id": "T14",
      "topic": "日本語",
      "valid": true,
      "desc": "multibyte topic, 9 bytes"
    },
    {
      "id": "T15",
      "topic": "日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日",
      "valid": false,
      "desc": "THE LENGTH LIMIT IS BYTES, NOT CHARACTERS — 86 characters, 258 UTF-8 bytes. An implementation measuring String.length (UTF-16 units) accepts this and diverges."
    },
    {
      "id": "T16",
      "topic": "🚀",
      "valid": true,
      "desc": "astral plane, 4 bytes, 2 UTF-16 units"
    }
  ],
  "idOrder": [
