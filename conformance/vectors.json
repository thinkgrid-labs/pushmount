    {
      "id": "P20",
      "raw": "0-9007199254740992",
      "valid": false,
      "desc": "the same bound applies to the seq half"
    },
    {
      "id": "P21",
      "raw": "18446744073709551615-0",
      "valid": false,
      "desc": "u64::MAX — accepted by a naive 64-bit parser, unrepresentable in JavaScript"
    }
  ],
  "monotonic": [
    {
      "id": "M1",
      "desc": "clock regression must not produce a cursor regression",
      "nowMs": [
        1000,
        999,
        999
      ],
      "expected": [
        "1000-0",
        "1000-1",
        "1000-2"
      ]
    },
    {
      "id": "M2",
      "desc": "seq resets only when ms actually advances",
      "nowMs": [
        1000,
        1000,
        1001
      ],
      "expected": [
        "1000-0",
        "1000-1",
        "1001-0"
      ]
    },
    {
      "id": "M3",
      "desc": "a stalled clock keeps incrementing seq",
      "nowMs": [
        5,
        5,
        5,
        5
      ],
      "expected": [
        "5-0",
        "5-1",
        "5-2",
        "5-3"
      ]
    }
  ],
  "checkpoint": [
