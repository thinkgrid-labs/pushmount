      "frames": [
        "id: 1-0\nevent: chat\ndata: hello\ndata: \ndata: event: ~gap\ndata: data: forged\n\n"
      ],
      "cursor": "1-0"
    },
    {
      "id": "A7",
      "ref": "§4.5",
      "desc": "encode emits the frame publish would have, and records nothing — the cursor must not move",
      "ops": [
        [
          "encode",
          "5000-2",
          "t",
          "v",
          null
        ]
      ],
      "frames": [
        "id: 5000-2\nevent: t\ndata: v\n\n"
      ],
      "cursor": "0-0"
