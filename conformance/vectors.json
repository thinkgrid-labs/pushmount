    {
      "id": "P18",
      "raw": "0-9007199254740991",
      "valid": true,
      "desc": "2^53-1 is the largest seq, and it parses"
    },
    {
      "id": "P19",
      "raw": "9007199254740992-0",
      "valid": false,
      "desc": "2^53 — an f64 cannot distinguish it from its neighbour, so it cannot name one event"
